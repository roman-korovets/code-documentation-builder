    {
      "slug": "high-contrast",
      "displayName": "High Contrast Mode",
      "hintPatterns": ["highContrast", "HighContrast"]
    },
    {
      "slug": "hierarchy-colors",
      "displayName": "Hierarchy Colors",
      "hintPatterns": ["hierarchyColor", "HierarchyColor"]
    },
    {
      "slug": "task-editing",
      "displayName": "Task Editing",
      "hintPatterns": ["taskbarEditing", "actionBegin", "actionComplete", "handleTaskbar"]
