      "hintPatterns": ["\\bcf[A-Z]", "\\bcfRules", "conditionalFormatting", "applyConditionalFormatting", "reapplyCf"]
    },
    {
      "slug": "custom-filters",
      "displayName": "Custom Filters",
      "pathPatterns": ["/custom-filters/", "applyCustomFilter"],
      "hintPatterns": ["customFilter"]
